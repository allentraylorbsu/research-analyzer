# Physician Workforce Research Analyzer - Environment Variables
# Copy this file to .env and fill in the keys you want to use.
#
# NOTHING here is strictly required. The app runs with no keys at all —
# open "State Workforce Rankings" and click "Load Demo Data" to see the
# ranking system work. Each key below unlocks specific features.
#
# All variables must be prefixed with VITE_ to be readable in the browser.
# These values only PREFILL the in-app "API Configuration" form; whatever is
# in that form is what gets used, and it persists to browser localStorage.

# =============================================================================
# OpenAI  — unlocks: paper analysis, AI connection suggestions
# =============================================================================
# Get a key: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Supabase  — unlocks: persistent storage
# =============================================================================
# Without these the app works but nothing is saved between reloads, and
# "Calculate from Data" in State Rankings will report "Database not configured".
# Get credentials: https://supabase.com/dashboard
# Schema to apply: supabase-schema.sql in this repo
#
# NOTE: free-tier Supabase projects are paused after a period of inactivity.
# If saving suddenly fails, check the dashboard and restore the project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anonymous/public key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# LegiScan  — unlocks: "LegiScan Import" (legislation from all 50 states)
# =============================================================================
# Get a key: https://legiscan.com/legiscan
VITE_LEGISCAN_API_KEY=your-legiscan-api-key-here

# =============================================================================
# Open States  — unlocks: state legislation in "Discover Policies"
# =============================================================================
# Free. Get a key: https://openstates.org/accounts/login/
VITE_OPENSTATES_API_KEY=your-openstates-api-key-here

# =============================================================================
# NewsAPI  — unlocks: recent policy news in "Discover Policies"
# =============================================================================
# Free tier: 100 requests/day. Get a key: https://newsapi.org/register
VITE_NEWSAPI_KEY=your-newsapi-key-here

# =============================================================================
# No key needed
# =============================================================================
# PubMed (NCBI E-utilities) — "Search PubMed" works out of the box.
# GDELT — historical news (up to 5 years) in "Discover Policies", free/keyless.

# =============================================================================
# Notes
# =============================================================================
# - Never commit your actual .env file. It is in .gitignore.
# - This is a client-side research tool: keys live in the browser and API calls
#   are made directly from it. Do not deploy publicly with production keys.
